{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "ts-node": {
    "transpileOnly": true,
    "moduleTypes": {
      "**/*.ts": "esm",
      "**/*.tsx": "esm",
      "**/*.mts": "esm"
    }
  }
}
